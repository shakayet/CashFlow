# Copy to .env for local development. Production values belong in a secret manager.

# Runtime
NODE_ENV=development
IP_ADDRESS=0.0.0.0
PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/cashflow
DATABASE_SERVER_SELECTION_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=1
SOCKET_PING_TIMEOUT_MS=60000
SOCKET_EVENT_RATE_LIMIT_WINDOW_MS=60000
SOCKET_EVENT_RATE_LIMIT_MAX=120

# HTTP safeguards
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=65000
HTTP_KEEP_ALIVE_TIMEOUT_MS=60000
SHUTDOWN_TIMEOUT_MS=15000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
EXPENSIVE_RATE_LIMIT_MAX=30

# Authentication
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRE_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_REFRESH_EXPIRE_IN=30d

# Email (TLS is required)
EMAIL_FROM=noreply@example.com
EMAIL_USER=noreply@example.com
EMAIL_PASS=replace-me
EMAIL_PORT=587
EMAIL_HOST=smtp.example.com

# Object storage
AWS_BUCKET=cashflow-development
AWS_REGION=us-east-1
# Optional CloudFront URL, without a trailing slash
CLOUDFRONT_DOMAIN=
BRAND_LOGO_URL=
OCR_LANGUAGE_DATA_PATH=.

# Initial administrator
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Google OAuth (disabled unless explicitly enabled)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/v1/oauth/google/callback
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Apple App Store subscriptions (disabled unless explicitly enabled)
APPLE_SUBSCRIPTIONS_ENABLED=false
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=
APPLE_APP_ID=
# Use either an escaped PEM value (\\n supported) or an absolute file path.
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
APPLE_ROOT_CERTIFICATE_PATHS=certs/apple/AppleIncRootCertificate.cer,certs/apple/AppleRootCA-G2.cer,certs/apple/AppleRootCA-G3.cer
APPLE_PRODUCT_MAP={}
APPLE_STATUS_CACHE_MS=60000
